NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/juri4?schema=public

# Для доступа извне укажите IP/домен вашего сервера, напр.:
# CORS_ORIGIN=http://192.168.1.10:3080,http://localhost:3080
CORS_ORIGIN=http://localhost:3080
COOKIE_SECRET=dev_cookie_secret_change_me
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

INTEGRATION_API_KEY=dev_integration_key_change_me

UPLOAD_DIR=/data/uploads
FILE_MAX_SIZE_BYTES=15728640
